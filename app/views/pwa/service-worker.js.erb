const RELEASE = "<%= service_worker_release %>"
const PAGES = "handbook-pages"
const ASSETS = `handbook-assets-${RELEASE}`
const OFFLINE_PATH = "<%= offline_path %>"

self.addEventListener("install", (event) => {
  event.waitUntil(precache().catch(() => {}).then(() => self.skipWaiting()))
})

self.addEventListener("activate", (event) => {
  event.waitUntil(sweep().catch(() => {}).then(() => self.clients.claim()))
})

self.addEventListener("fetch", (event) => {
  const { request } = event
  if (request.method !== "GET" || request.headers.has("Range")) return

  const url = new URL(request.url)
  if (url.origin !== self.location.origin) return

  if (isPage(request)) {
    event.respondWith(page(event))
  } else if (url.pathname.startsWith("/assets/")) {
    event.respondWith(asset(event))
  }
})

// Turbo fetches a page rather than navigating to it, so mode alone would miss
// every link a rider actually taps. Frames and streams are fragments and must
// never be stored under a page's own url.
function isPage(request) {
  if (request.mode === "navigate") return true
  if (request.headers.get("Turbo-Frame")) return false

  const accept = request.headers.get("Accept") || ""
  if (accept.includes("text/vnd.turbo-stream.html")) return false

  return accept.includes("text/html")
}

async function precache() {
  const cache = await caches.open(ASSETS)
  const response = await fetch(OFFLINE_PATH, { cache: "reload" })
  if (response.status === 200 && !response.redirected) await cache.put(OFFLINE_PATH, response)
}

async function sweep() {
  const names = await caches.keys()
  const stale = names.filter((name) => name.startsWith("handbook-assets-") && name !== ASSETS)
  await Promise.all(stale.map((name) => caches.delete(name)))
}

// Network first. Reading a cheat sheet with no bars is the point, but a corking
// rotation that changed last week is a safety problem.
async function page(event) {
  const key = new URL(event.request.url).href

  try {
    const response = await fetch(event.request)
    if (response.status === 200 && !response.redirected) {
      const cache = await caches.open(PAGES)
      const allowed = response.headers.get("X-Offline-Cache") === "allowed"
      event.waitUntil((allowed ? cache.put(key, response.clone()) : cache.delete(key)).catch(() => {}))
    }
    return response
  } catch (error) {
    return (await caches.match(key, { ignoreVary: true, cacheName: PAGES })) ||
      (await caches.match(OFFLINE_PATH, { cacheName: ASSETS })) ||
      Response.error()
  }
}

async function asset(event) {
  const cached = await caches.match(event.request, { cacheName: ASSETS })
  if (cached) return cached

  try {
    const response = await fetch(event.request)
    if (response.status === 200) {
      const cache = await caches.open(ASSETS)
      event.waitUntil(cache.put(event.request, response.clone()).catch(() => {}))
    }
    return response
  } catch (error) {
    return Response.error()
  }
}
