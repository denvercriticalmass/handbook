<% if flash[:signed_out] %>
  <div data-controller="signed-out"></div>
<% end %>

<h1>Sign in</h1>

<% if google_sign_in? %>
  <%# Turbo cannot follow the cross-origin redirect to Google. %>
  <%= button_to "Continue with Google", google_sign_in_path, data: { turbo: false } %>
<% end %>

<%= form_with url: passkey_session_path,
      data: {
        controller: "passkey",
        action: "submit->passkey#signin",
        passkey_challenge_url_value: passkey_challenge_path
      } do |form| %>
  <%= form.hidden_field :credential, data: { passkey_target: "credential" } %>

  <%= form.submit "Sign in with a passkey" %>
<% end %>

<%= form_with url: session_url do |form| %>
  <%= form.label :email_address, "Email address" %>

  <%= form.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        value: params[:email_address] %>

  <%= form.label :password %>

  <%= form.password_field :password,
        required: true,
        autocomplete: "current-password",
        maxlength: 72 %>

  <%= form.submit "Sign in" %>
<% end %>

<p><%= link_to "Forgot password?", new_password_path %></p>

<p><%= link_to "Back to the handbook", root_path %></p>

<% if Rails.env.development? %>
  <%= button_to "Sign in as the superadmin", dev_signin_path %>
<% end %>
