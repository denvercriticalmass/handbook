<!DOCTYPE html>

<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <nav>
      <%= link_to "Handbook", root_path %>

      <% if authenticated? %>
        <%= link_to "Guides", admin_guides_path %>
        <%= link_to "Cheat sheets", admin_cheat_sheets_path %>
        <%= link_to "Invite", new_admin_invitation_path %>
        <%= link_to "Admins", admin_users_path if policy(User).index? %>
        <%= link_to "Account", admin_account_path %>
        <%= button_to "Sign out", session_path, method: :delete %>
      <% end %>
    </nav>

    <main>
      <% if alert = flash[:alert] %>
        <p id="alert" role="alert"><%= alert %></p>
      <% end %>

      <% if notice = flash[:notice] %>
        <p id="notice" role="status"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
