<% if authenticated? %>
  <nav>
    <ul>
      <li>
        <%= link_to root_path do %>
          <%= render "icons/home" %>
          <span>Handbook</span>
        <% end %>
      </li>

      <li>
        <%= link_to admin_guides_path do %>
          <%= render "icons/guides" %>
          <span>Guides</span>
        <% end %>
      </li>

      <li>
        <%= link_to admin_cheat_sheets_path do %>
          <%= render "icons/cheat_sheets" %>
          <span>Cheat sheets</span>
        <% end %>
      </li>

      <% if policy(User).index? %>
        <li>
          <%= link_to admin_users_path do %>
            <%= render "icons/admins" %>
            <span>Admins</span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <details data-controller="menu">
      <summary>
        <%= render "icons/account" %>
        <span><%= Current.user.name %></span>
      </summary>

      <ul>
        <li><%= link_to "Account", admin_account_path %></li>
        <li><%= button_to "Sign out", session_path, method: :delete %></li>
      </ul>
    </details>
  </nav>
<% elsif Rails.env.development? %>
  <%# Public pages have no way in on purpose. This is one while working. %>
  <nav>
    <ul>
      <li><%= link_to "Handbook", root_path %></li>
      <li><%= link_to "Sign in", signin_path %></li>
    </ul>
  </nav>
<% end %>
