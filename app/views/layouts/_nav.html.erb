<% if authenticated? %>
  <nav>
    <%= link_to "Handbook", root_path %>
    <%= link_to "Guides", admin_guides_path %>
    <%= link_to "Cheat sheets", admin_cheat_sheets_path %>
    <%= link_to "Admins", admin_users_path if policy(User).index? %>

    <details data-controller="menu">
      <summary><%= Current.user.name %></summary>

      <ul>
        <li><%= link_to "Account", admin_account_path %></li>
        <li><%= button_to "Sign out", session_path, method: :delete %></li>
      </ul>
    </details>
  </nav>
<% elsif Rails.env.development? %>
  <%# Public pages have no way in on purpose. This is one while working. %>
  <nav>
    <%= link_to "Handbook", root_path %>
    <%= link_to "Sign in", signin_path %>
  </nav>
<% end %>
