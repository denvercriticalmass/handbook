<h1>Admins</h1>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= user.email_address %> (<%= user.role %><%= ", suspended" unless user.active? %>)

      <% if policy(user).manage? %>
        <%= button_to user.active? ? "Suspend" : "Reinstate",
              admin_user_path(user),
              method: :patch,
              params: { active: !user.active? } %>
      <% end %>
    </li>
  <% end %>
</ul>
