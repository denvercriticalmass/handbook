<%= form_with model: guide, url: url do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title, required: true, autofocus: true %>

  <%= form.label :body %>
  <%= form.rich_textarea :body %>

  <%= form.label :tag_list, "Tags" %>
  <%= form.text_field :tag_list, value: guide.tag_list.to_s %>

  <%= form.submit "Save" %>
<% end %>
