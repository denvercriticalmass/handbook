<h1>Guides</h1>

<p><%= link_to "Write a guide", new_admin_guide_path %></p>

<% if @guides.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Updated</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @guides.each do |guide| %>
        <tr>
          <td><%= link_to guide.title, edit_admin_guide_path(guide) %></td>
          <td><%= guide.updated_at.strftime("%-d %b %Y") %></td>
          <td><%= link_to "History", history_admin_guide_path(guide) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No guides yet.</p>
<% end %>
