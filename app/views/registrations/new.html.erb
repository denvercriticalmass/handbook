<h1>Create the first account</h1>

<%= form_with url: signup_path do |form| %>
  <%= form.hidden_field :token, value: params[:token] %>

  <%= form.label :name %>
  <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %>

  <%= form.label :email_address, "Email address" %>
  <%= form.email_field :email_address, required: true, autocomplete: "username" %>

  <%= form.label :password %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>

  <%= form.submit "Create account" %>
<% end %>

<p><%= link_to "Back to the handbook", root_path %></p>
