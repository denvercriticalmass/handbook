<% if guides.any? %>
  <h2>Guides</h2>

  <ul>
    <% guides.each do |guide| %>
      <li><%= link_to guide.title, guide_path(guide) %></li>
    <% end %>
  </ul>
<% end %>

<% if cheat_sheets.any? %>
  <h2>Cheat sheets</h2>

  <ul>
    <% cheat_sheets.each do |cheat_sheet| %>
      <li><%= link_to cheat_sheet.title, cheat_sheet_path(cheat_sheet) %></li>
    <% end %>
  </ul>
<% end %>
