amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["rubocop"] {
        types = List("ruby")
        check = "bin/rubocop --force-exclusion {{ files }}"
        fix = "bin/rubocop --force-exclusion --autocorrect {{ files }}"
    }
    ["herb"] {
        glob = "**/*.html.erb"
        check = "bin/herb analyze app"
    }
    ["herb-format"] {
        glob = "**/*.html.erb"
        check = "npx herb-format --check {{ files }}"
        fix = "npx herb-format {{ files }}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
